# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database Connection (Optional in DEMO_MODE, recommended for production)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/mentorconnect?retryWrites=true&w=majority"

# JWT Secret for signing auth tokens
# Used to sign login tokens (HMAC). Change it for any real deployment.
JWT_SECRET="mentor_connect_super_secret_jwt_key_rethink26"

# Cloudinary Storage for mentor verification documents & avatars (optional)
CLOUDINARY_CLOUD_NAME="demo-mentorconnect"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_cloudinary_secret"

# Client and Server URLs
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"

# DEMO_MODE enables instant seed data and high-resilience presentation mode
DEMO_MODE=true

# Gemini model id (change if your API key uses a different model name)
GEMINI_MODEL="gemini-3.8-flash"

# ---- Video calls across different networks (college wifi <-> mobile data) need a TURN server ----
# Default = free public Open Relay (fine for demos). For reliability create a free key at https://www.metered.ca/tools/openrelay/
# and fill these three (comma-separate multiple URLs):
# TURN_URL="turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp"
# TURN_USERNAME="your_username"
# TURN_CREDENTIAL="your_credential"
